# HOOOPLAAA INCORPORATED — ENVIRONMENT CONFIGURATION (SAMPLE / SANDBOX)
# Copy this file to .env.local for development.
# NEVER commit real production API keys or merchant secrets.

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="HOOOPLAAA INCORPORATED"
NEXT_PUBLIC_APP_TAGLINE="Attract. Connect. Convert. Grow."

# Supabase Configuration (Local / Sandbox)
NEXT_PUBLIC_SUPABASE_URL=https://aqmyqezuoscpgqwtvblu.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key-never-use-service-role-in-client
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-server-only

# Payment Gateway Adapters
# Mode: "sandbox" | "mock" | "production" (production requires merchant sign-off)
PAYMENT_MODE=sandbox
SSLCOMMERZ_STORE_ID=sandbox_hoooplaaa_test
SSLCOMMERZ_STORE_PASS=sandbox_hoooplaaa_secret
SSLCOMMERZ_IS_SANDBOX=true

# Manual MFS Payment Options (bKash / Nagad / Bank Transfer)
MANUAL_MFS_ENABLED=true
MANUAL_MFS_BKASH_NUMBER="01XXXXXXXXX (Personal / Agent - Simulation)"
MANUAL_MFS_NAGAD_NUMBER="01XXXXXXXXX (Personal / Agent - Simulation)"

# Communications & Notifications (Sandbox Mock by default)
EMAIL_PROVIDER_MODE=mock
NOTIFICATION_EMAIL_FROM="orders@hoooplaaa.com"

# Internal Security & Rate Limiting
INTERNAL_AUDIT_SALT="hoooplaaa-audit-salt-local-development"
